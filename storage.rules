rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function imageUpload() {
      return request.resource != null &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    function isBusinessMember(businessId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && imageUpload();
    }

    match /businesses/{businessId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isBusinessMember(businessId) && imageUpload();
    }

    // Review images — anyone can upload (reviews require no login, but are
    // moderated by the business owner before becoming publicly visible)
    match /businesses/{businessId}/public/reviews/{fileName} {
      allow read: if true;
      allow write: if imageUpload();
    }

    match /businesses/{businessId}/private/{allPaths=**} {
      allow read: if isBusinessMember(businessId);
      allow write: if isBusinessMember(businessId) && imageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
