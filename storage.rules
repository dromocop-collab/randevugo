rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function imageUpload() {
      return request.resource != null &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 5 * 1024 * 1024;
    }

    // İşletme vitrin görselleri yalnızca sahip/admin/müdür tarafından değiştirilebilir.
    function canManageBusiness(businessId) {
      return signedIn() && (
        firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid ||
        (firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role in ["owner", "admin", "manager"])
      );
    }

    function isBusinessMember(businessId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && imageUpload();
    }

    match /businesses/{businessId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if canManageBusiness(businessId) && imageUpload();
    }

    // Yorum görselleri yorumu yazan kullanıcıya aittir; mevcut dosyanın üzerine yazılamaz.
    match /businesses/{businessId}/public/reviews/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && imageUpload() && resource == null;
    }

    match /businesses/{businessId}/private/{allPaths=**} {
      allow read: if isBusinessMember(businessId);
      allow write: if isBusinessMember(businessId) && imageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
