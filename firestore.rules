rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isPrimaryAdminEmail() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('(?i)^cihatwin@gmail\\.com$');
    }

    function isPlatformAdmin() {
      return isPrimaryAdminEmail() ||
        (signedIn() &&
          exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)));
    }

    function businessDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId));
    }

    function businessExists(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId));
    }

    function businessActive(businessId) {
      return businessExists(businessId) &&
        businessDoc(businessId).data.isSuspended != true;
    }

    function businessPublished(businessId) {
      return businessExists(businessId) &&
        businessDoc(businessId).data.isPublished == true;
    }

    function isBootstrapOwner(businessId) {
      return signedIn() &&
        existsAfter(/databases/$(database)/documents/businesses/$(businessId)) &&
        getAfter(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    function isOwner(businessId) {
      return signedIn() &&
        businessExists(businessId) &&
        businessDoc(businessId).data.ownerUid == request.auth.uid;
    }

    function memberDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function isMember(businessId) {
      return signedIn() &&
        businessActive(businessId) &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function hasRole(businessId, allowedRoles) {
      return isMember(businessId) &&
        memberDoc(businessId).data.uid == request.auth.uid &&
        memberDoc(businessId).data.role in allowedRoles;
    }

    function canManage(businessId) {
      return isOwner(businessId) ||
        hasRole(businessId, ['owner', 'admin', 'manager']);
    }

    function canOperate(businessId) {
      return isOwner(businessId) ||
        hasRole(businessId, ['owner', 'admin', 'manager', 'staff']);
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /platformAdmins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /businessSlugs/{slug} {
      allow read: if true;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.businessId is string;
      allow update, delete: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (
        isOwner(resource.data.businessId) ||
        hasRole(resource.data.businessId, ['owner', 'admin', 'manager'])
      );

      allow create: if signedIn() &&
        request.resource.data.businessId is string &&
        isOwner(request.resource.data.businessId);

      allow update: if signedIn() &&
        resource.data.businessId is string &&
        isOwner(resource.data.businessId);

      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if businessPublished(businessId) || isOwner(businessId) || isMember(businessId) || isPlatformAdmin();
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(businessId) || isPlatformAdmin();

      match /members/{uid} {
        allow read: if (signedIn() && uid == request.auth.uid) || isMember(businessId) || isPlatformAdmin();
        allow create: if canManage(businessId) ||
          isPlatformAdmin() ||
          (isBootstrapOwner(businessId) &&
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'owner');
        allow update, delete: if canManage(businessId) || isPlatformAdmin();
      }

      match /branches/{documentId} {
        allow read: if isMember(businessId) ||
          businessPublished(businessId) ||
          isPlatformAdmin();
        allow write: if canManage(businessId);
      }

      match /staff/{documentId} {
        allow read: if isMember(businessId) ||
          businessPublished(businessId) ||
          isPlatformAdmin();
        allow write: if canManage(businessId);
      }

      match /services/{documentId} {
        allow read: if resource.data.isActive == true || isMember(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId);
      }

      match /workingHours/{documentId} {
        allow read: if isMember(businessId) ||
          businessPublished(businessId) ||
          isPlatformAdmin();
        allow create: if canManage(businessId) || isBootstrapOwner(businessId);
        allow update, delete: if canManage(businessId);
      }

      match /specialDays/{documentId} {
        allow read: if isMember(businessId) || businessPublished(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId);
      }

      match /customers/{documentId} {
        allow read: if canOperate(businessId) || isPlatformAdmin();
        allow write: if canOperate(businessId);
      }

      match /appointments/{appointmentId} {
        allow read: if canOperate(businessId) || isPlatformAdmin();

        // Müşteri tarafı doğrudan randevu oluşturmaz.
        // Çakışma kontrolü ve doğrulama Cloud Function üzerinden yapılır.
        allow create: if false;

        allow update: if canOperate(businessId);
        allow delete: if canManage(businessId);
      }

      match /notifications/{documentId} {
        allow read: if canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId);
      }

      match /auditLogs/{documentId} {
        allow read: if canManage(businessId) || isPlatformAdmin();
        allow write: if false;
      }
    }
  }
}
