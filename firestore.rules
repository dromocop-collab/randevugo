rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────
    // Helper functions
    // ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "cihatwin@gmail.com" ||
         exists(/databases/$(database)/documents/platformAdmins/$(uid())));
    }

    // Check ownerUid on the business document itself (works in transactions)
    function isBusinessOwner(businessId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == uid();
    }

    function isMember(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid()));
    }

    function getMember(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid()));
    }

    function isOwner(businessId) {
      return isMember(businessId) &&
        getMember(businessId).data.role == "owner";
    }

    function canManage(businessId) {
      return isMember(businessId) &&
        getMember(businessId).data.role in ["owner", "admin", "manager"];
    }

    function canOperate(businessId) {
      return isMember(businessId) &&
        getMember(businessId).data.role in ["owner", "admin", "manager", "staff"];
    }

    function isPublicBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.isPublished == true;
    }

    // Protect fields that should only be changed by server/admin
    function protectedFieldsUnchanged() {
      return (!request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(["rating", "reviewCount", "isVerified", "status", "isSuspended",
          "approvalStatus", "storePosition", "reviewedBy", "reviewedAt", "plan"]));
    }

    // ────────────────────────────────────────────────
    // Platform Admin Collections
    // ────────────────────────────────────────────────
    match /platformAdmins/{adminId} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /platformSettings/{doc} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // API anahtarları yalnızca callable Cloud Functions tarafından okunur/yazılır.
    match /platformPrivateSettings/{doc} {
      allow read, write: if false;
    }

    match /platformPlans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isPlatformAdmin();
    }

    match /businessApprovalRequests/{businessId} {
      allow read: if isPlatformAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == uid());
      allow write: if isPlatformAdmin();
    }

    match /platformAuditLogs/{docId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ────────────────────────────────────────────────
    // Categories (platform-managed)
    // ────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ────────────────────────────────────────────────
    // Appointment Tokens (Public Access)
    // ────────────────────────────────────────────────
    match /appointmentTokens/{token} {
      allow read: if true;
      allow write: if false;
    }

    // ────────────────────────────────────────────────
    // Users Collection
    // ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (uid() == userId || isPlatformAdmin());
      allow create: if isAuthenticated() && uid() == userId;
      allow update: if isAuthenticated() && uid() == userId;
      allow delete: if false;

      match /favorites/{businessId} {
        allow read, write: if isAuthenticated() && uid() == userId;
      }
    }

    // ────────────────────────────────────────────────
    // Subscriptions
    // ────────────────────────────────────────────────
    match /subscriptions/{businessId} {
      allow read: if isAuthenticated() &&
        (isMember(businessId) || isPlatformAdmin());
      // İşletme yalnızca kendi ilk deneme kaydını oluşturabilir. Paket, ödeme
      // sağlayıcısı ve durum yükseltmeleri callable Cloud Function/admin işidir.
      allow create: if isPlatformAdmin() ||
        (isAuthenticated() &&
         request.resource.data.businessId == businessId &&
         (isMember(businessId) || isBusinessOwner(businessId)) &&
         request.resource.data.plan == "RANDEVUGO" &&
         request.resource.data.status == "trialing" &&
         request.resource.data.paymentProvider == "manual" &&
         request.resource.data.renewalEnabled == false &&
         request.resource.data.keys().hasOnly([
           "businessId", "plan", "status", "trialStartedAt", "trialEndsAt",
           "renewalEnabled", "paymentProvider", "createdAt", "updatedAt"
         ]));
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ────────────────────────────────────────────────
    // Support Tickets
    // ────────────────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read: if isPlatformAdmin() ||
        (isAuthenticated() &&
          (resource.data.userId == uid() ||
           (resource.data.businessId is string && isMember(resource.data.businessId))));
      // Server-only: enforces the maximum of three stores and approval for stores two/three.
      allow create: if false;
      allow update: if isPlatformAdmin() ||
        (isAuthenticated() &&
          (resource.data.userId == uid() ||
           (resource.data.businessId is string && isMember(resource.data.businessId))) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "updatedAt"]));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isPlatformAdmin() ||
          (isAuthenticated() &&
            (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == uid() ||
             (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.businessId is string &&
              isMember(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.businessId))));
        allow create: if isPlatformAdmin() ||
          (isAuthenticated() &&
            (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == uid() ||
             (get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.businessId is string &&
              isMember(get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.businessId))) &&
            request.resource.data.senderId == uid() &&
            request.resource.data.body is string &&
            request.resource.data.body.size() > 0 &&
            request.resource.data.body.size() <= 5000 &&
            request.resource.data.keys().hasOnly(["body", "senderId", "senderRole", "createdAt"]));
      }
    }


    // ────────────────────────────────────────────────
    // Notification Logs (platform-level)
    // ────────────────────────────────────────────────
    match /notificationLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ────────────────────────────────────────────────
    // Business Slugs (URL slugs → businessId mapping)
    // ────────────────────────────────────────────────
    match /businessSlugs/{slug} {
      // Public read — storefront resolves slug to businessId
      allow read: if true;
      allow create: if false;
      // Only the owner or platform admin can update/delete
      allow update, delete: if isPlatformAdmin() ||
        (isAuthenticated() && resource.data.ownerUid == uid());
    }

    // ────────────────────────────────────────────────
    // Category Requests (custom category approval flow)
    // ────────────────────────────────────────────────
    match /categoryRequests/{requestId} {
      // Platform admins can read all; businesses can read their own
      allow read: if isPlatformAdmin() ||
        (resource.data.businessId is string && isMember(resource.data.businessId));
      // Authenticated businesses can request a new platform category.
      allow create: if request.resource.data.businessId is string &&
        isMember(request.resource.data.businessId) &&
        request.resource.data.status == "pending" &&
        request.resource.data.requestedCategory is string &&
        request.resource.data.requestedCategory.size() > 1 &&
        request.resource.data.requestedCategory.size() <= 80 &&
        request.resource.data.keys().hasOnly([
          "businessId", "businessName", "requestedCategory", "status", "requestedAt"
        ]);
      // Only platform admins can approve/reject
      allow update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Customer account uses a collection-group query across every business.
    // Keep this narrowly scoped: a signed-in customer can only read rows whose
    // customerId is their own Firebase Auth uid.
    match /{path=**}/appointments/{appointmentId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == uid() || isPlatformAdmin());
    }

    // ────────────────────────────────────────────────
    // Businesses
    // ────────────────────────────────────────────────
    match /businesses/{businessId} {
      // Public read for published businesses, members, owner, or admin
      allow read: if resource.data.isPublished == true ||
        (isAuthenticated() && resource.data.ownerUid == uid()) ||
        isMember(businessId) ||
        isPlatformAdmin();
      // Business creation is server-only so the three-store limit and approval
      // workflow cannot be bypassed by a direct client write.
      allow create: if false;
      // Owner or manager can update but cannot change protected fields
      allow update: if isPlatformAdmin() ||
        (isBusinessOwner(businessId) && protectedFieldsUnchanged()) ||
        (canManage(businessId) && protectedFieldsUnchanged());
      allow delete: if isPlatformAdmin();

      // Members
      match /members/{memberId} {
        allow read: if isMember(businessId) || isPlatformAdmin();
        // Allow initial member creation during onboarding:
        // The creator sets themselves as owner with their own uid
        allow create: if isAuthenticated() &&
          (isOwner(businessId) || isPlatformAdmin() ||
           (memberId == uid() &&
            request.resource.data.uid == uid() &&
            request.resource.data.role == "owner"));
        allow update, delete: if isOwner(businessId) || isPlatformAdmin();
      }

      // Services (public read for storefront)
      match /services/{serviceId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isPlatformAdmin();
      }

      // Service Categories (public read, owner/manager write)
      match /serviceCategories/{categoryId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isBusinessOwner(businessId) || isPlatformAdmin();
      }

      // Staff (public read for storefront)
      match /staff/{staffId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isPlatformAdmin();
      }

      // Working Hours (public read for availability)
      match /workingHours/{hourId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isBusinessOwner(businessId) || isPlatformAdmin();
      }

      // Special Days (holidays, leaves, custom)
      match /specialDays/{dayId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isPlatformAdmin();
      }

      // Appointments — created via Cloud Function only
      match /appointments/{appointmentId} {
        allow read: if canOperate(businessId) ||
          isPlatformAdmin() ||
          (isAuthenticated() && resource.data.customerId == uid());
        allow create: if false; // Only via Cloud Function
        allow update: if isPlatformAdmin() ||
          (canOperate(businessId) &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "paymentStatus", "updatedAt"]));
        allow delete: if false;
      }

      // Customers (private CRM data)
      match /customers/{customerId} {
        allow read: if canOperate(businessId) || isPlatformAdmin();
        allow write: if canOperate(businessId) || isPlatformAdmin();
      }

      // Reviews are created and moderated by callable Cloud Functions.
      match /reviews/{reviewId} {
        allow read: if resource.data.isVisible == true ||
          canManage(businessId) || isPlatformAdmin();
        allow create: if false;
        allow update: if canManage(businessId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["ownerReply", "ownerReplyAt", "updatedAt"]);
        allow delete: if isPlatformAdmin();
      }

      // Notifications
      match /notifications/{notifId} {
        allow read: if isMember(businessId);
        allow write: if isMember(businessId) || isPlatformAdmin();
      }

      // Audit Logs (business-level, server-write only)
      match /auditLogs/{logId} {
        allow read: if canManage(businessId) || isPlatformAdmin();
        allow write: if false;
      }

      // Branches
      match /branches/{branchId} {
        allow read: if isPublicBusiness(businessId) || canOperate(businessId) || isPlatformAdmin();
        allow write: if canManage(businessId) || isPlatformAdmin();
      }
    }

    // ────────────────────────────────────────────────
    // Dynamic Categories (approved custom categories)
    // ────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    // ────────────────────────────────────────────────
    // Verification Codes (server-only via Admin SDK)
    // ────────────────────────────────────────────────
    match /verificationCodes/{phone} {
      allow read, write: if false; // Only Cloud Functions can access
    }

    match /emailVerificationCodes/{email} {
      allow read, write: if false; // Only Cloud Functions can access
    }

    match /passwordResetCodes/{email} {
      allow read, write: if false; // Only Cloud Functions can access
    }

    // ────────────────────────────────────────────────
    // Trigger Email Extension (server-only)
    // ────────────────────────────────────────────────
    match /mail/{mailId} {
      allow read, write: if false; // Only Cloud Functions / Extensions can access
    }

    // ────────────────────────────────────────────────
    // Collection Group queries
    // ────────────────────────────────────────────────
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() && resource.data.uid == uid();
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if isPlatformAdmin();
    }
  }
}
